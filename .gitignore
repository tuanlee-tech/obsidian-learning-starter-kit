# Obsidian workspace & cache (mỗi người dùng có layout riêng)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/*/data.json

# OS generated files
.DS_Store
Thumbs.db
*~

# Scratch / Temp files
*.tmp
*.bak

# Ephemeral Antigravity NotebookLM active-session state & Python cache
.agents/plugins/notebooklm-study/.state/
__pycache__/
*.py[cod]

# Local study source files (PDF/DOCX/PPTX/audio — keep folder structure only)
sources/*
!sources/.gitkeep
